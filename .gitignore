# =============================================================================
# ROOT .gitignore — generic rules only (OS, editors, secrets)
# Backend-specific rules → backend/.gitignore
# Frontend-specific rules → frontend/.gitignore
# =============================================================================

# Secrets & environment
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Portable Node.js distribution (project-level tooling)
.node-dist/
.node-dist.tar.xz

# Example/test data files — never commit these
examples/
*.csv

# Database files
*.db