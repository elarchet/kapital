# Kapital - Environment Variables Template
# Copy this file to '.env' and fill in the actual secret values.

# Security & Authentication (In production, use a strong random key)
JWT_SECRET_KEY=your_super_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kapital

# Imported-file object storage.
# STORAGE_BACKEND=local stores files on disk under IMPORT_STORAGE_DIR (dev default).
# STORAGE_BACKEND=s3 works with any S3-compatible provider; for Oracle Object
# Storage use the S3 compatibility endpoint and a "Customer Secret Key":
#   S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION=<region>                      # e.g. eu-paris-1
#   S3_ACCESS_KEY_ID=<customer secret key access key>
#   S3_SECRET_ACCESS_KEY=<customer secret key secret>
STORAGE_BACKEND=local
IMPORT_STORAGE_DIR=static/import_files
#S3_ENDPOINT_URL=
#S3_REGION=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
